# Copy to .env for local runs. On Railway, set these in Variables.
# Never commit a real GROQ_API_KEY.

ENVIRONMENT=development
LOG_LEVEL=INFO

GROQ_API_KEY=
# Optional extra Groq keys for the same Qwen model. Rotate on 429 / timeout.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TITLE_VERIFY=true
GROQ_TIMEOUT=30

# "*" for public testing. Later set your Next.js origin, e.g.
# https://your-app.vercel.app
CORS_ORIGINS=*

OCR_MAX_UPLOAD_MB=50
OCR_MAX_PAGES=500
ENGINE_DOCS=true

# Concurrency. Leave all three unset in production: start.sh sizes workers from
# the container's vCPUs and each worker sizes its own extraction pool.
# WEB_CONCURRENCY=4          # uvicorn processes
# EXTRACT_WORKERS=4          # concurrent heavy extractions per process
# EXTRACT_QUEUE_TIMEOUT=20   # seconds to wait for a slot before 503

# Per-IP throttle, counted per worker process. 0 disables it. Keep it off or
# high when Next.js proxies uploads server-side, or one IP hits the cap.
RATE_LIMIT_PER_MINUTE=240
